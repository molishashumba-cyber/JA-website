# Copy to .env.local for local development, and add the same values
# in Vercel → Project → Settings → Environment Variables.
# Find them in Supabase → Project Settings → API Keys / Data API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: email alerts for new form submissions (https://resend.com).
# Without RESEND_API_KEY, submissions are still saved; only the email is skipped.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
FORM_ALERT_EMAIL=info@jazambia.org
# Until a domain is verified in Resend, keep the default sender below.
# FORM_ALERT_FROM=JA Zambia Website <website@jazambia.org>

# Set when the site moves to its real domain. Until then, search engines are
# asked not to list the temporary Vercel address.
# NEXT_PUBLIC_SITE_URL=https://jazambia.org
